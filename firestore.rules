rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni utente legge e scrive SOLO i propri dati (users/{suo uid}/...).
    // email_verified: gli account email/password devono aver confermato il
    // link (i provider come Google sono gia' verificati).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }

    // ── Estensione Stripe "Run Payments with Stripe" ──
    // L'utente legge il proprio profilo cliente/abbonamenti/pagamenti e puo'
    // creare sessioni di checkout; a scrivere lo stato pensa l'estensione.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid
                           && request.auth.token.email_verified == true;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Prodotti e prezzi sincronizzati dall'estensione: lettura pubblica.
    match /products/{id} {
      allow read: if true;
      match /prices/{priceId} { allow read: if true; }
    }
  }
}
